# Local-only. These live on a developer machine and are deliberately kept out of
# git; README.md is the whole committed documentation set, and CI gates lint,
# the tracked vitest suites, and the build. Nothing here is needed to build or
# run the app.

# Docs and agent files. README.md is the one committed README; scripts/README.md was
# folded into its data-pipeline section and kept here only as a local archive copy.
docs/
CLAUDE.md
CONTEXT.md
RELEASE_NOTES.md
scripts/README.md
perf/
.claude/

# Playwright: the specs, its config, and every baseline PNG
e2e/
playwright.config.ts
tsconfig.e2e.json

# Rendering test suites. The logic suites — src/ridership, src/utils, src/data,
# src/hooks, vite — stay tracked and are what CI runs.
src/__tests__/
src/chart/__tests__/
src/components/__tests__/
src/stops/__tests__/
