# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

.next

# Playwright (keep the committed Linux baselines, ignore run artifacts)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Visual-regression baselines: only the Linux set CI compares against is
# committed. Windows/macOS baselines are per-developer scratch — regenerate them
# locally with `npm run test:e2e:update`.
e2e/**/*-snapshots/*-win32.png
e2e/**/*-snapshots/*-darwin.png

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Raw data (commit compressed files only)
data/raw/*.csv
data/raw/*.xlsx

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
